{
  "name": "reportini",
  "private": true,
  "version": "0.2.10",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "description": "Gestione delle relazioni anagrafiche e degli appuntamenti su Google Calendar",
  "repository": {
    "type": "git",
    "url": "https://github.com/cazzevongole/Reportini.git"
  },
  "author": "cazzevongole",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/verifica-node.mjs && vitest run && bun scripts/smoke.mjs",
    "test:ui": "node scripts/verifica-node.mjs && vitest run",
    "preview": "vite preview",
    "electron:install": "cd electron && npm install",
    "electron:build": "ELECTRON=1 vite build && node scripts/copia-renderer.mjs",
    "electron:dev": "cd electron && npm run dev",
    "electron:pack": "bun run electron:build && cd electron && npm run dist",
    "edge:function:check": "node scripts/verifica-edge-function.mjs",
    "version:check": "node scripts/versione.mjs",
    "version:patch": "node scripts/versione.mjs patch",
    "version:minor": "node scripts/versione.mjs minor",
    "version:major": "node scripts/versione.mjs major",
    "icona": "node scripts/icona.mjs",
    "dimensioni": "node scripts/dimensioni.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.47",
    "prettier": "3.9.9",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
